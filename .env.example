################################################################################
# LoreShelf Backend — environment template
#
# Copy this file to `.env` and replace the placeholders with real values.
# `.env` is git-ignored, so credentials never end up in version control.
#
#   cp .env.example .env        # macOS / Linux
#   Copy-Item .env.example .env # Windows PowerShell
################################################################################

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the Express server listens on.
PORT=4000

# PostgreSQL connection string.
#
# For Neon: open your project in https://console.neon.tech, click
# "Connect", and copy the connection string. The host usually looks like:
#   ep-<name>-<id>-pooler.<region>.aws.neon.tech
# Keep `sslmode=require` — Neon refuses unencrypted connections.
#
# The value below is a PLACEHOLDER and will not connect. Replace it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-000000-pooler.us-east-2.aws.neon.tech:5432/loreshelf?sslmode=require

# Comma-separated list of origins allowed to call this API.
# Examples:
#   CORS_ORIGIN=*
#   CORS_ORIGIN=http://localhost:8081,https://loreshelf.example.com
CORS_ORIGIN=*

# Google Books requires an API key for public catalog searches.
# Get one from Google Cloud Console and restrict it to the Books API.
# GOOGLE_BOOKS_API_KEY=

# Optional contact information included in Open Library's User-Agent header.
# Supply an email address or phone number if you expect regular API usage.
# OPEN_LIBRARY_CONTACT=

# Authentication (backend only; generate a random secret with at least 32 bytes
# of entropy, then base64url encode it). These values are required in production.
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_43_RANDOM_BASE64URL_CHARACTERS
JWT_ISSUER=https://api.loreshelf.example
JWT_AUDIENCE=loreshelf-mobile

# Cloudinary signed cover uploads (backend only; never put the API secret in the app).
# Configure all three values together. Limit your Cloudinary account's maximum
# upload size to match the backend's 5 MiB cover limit where possible.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET
